{
  "name": "apt-analyzer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome ci frontend",
    "format": "biome format --write frontend",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
